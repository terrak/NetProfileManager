<Window x:Class="NetProfileManager.App.ConflictDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Profil déjà utilisé"
        Width="480" Height="230"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock x:Name="MessageText" TextWrapping="Wrap" Margin="0,0,0,10"/>
            <TextBlock Text="Quel réglage appliquer à la place sur cette carte ?" Margin="0,0,0,4"/>
            <ComboBox x:Name="ChoiceCombo" DisplayMemberPath="DisplayName"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Annuler" Click="Cancel_Click" Padding="14,5" Margin="0,0,8,0"/>
            <Button Content="Confirmer" Click="Confirm_Click" Padding="14,5" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
